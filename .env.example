# Aplicacao
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Configure uma das duas chaves administrativas abaixo.
# Chave legada service_role:
SUPABASE_SERVICE_ROLE_KEY=
# Ou a nova Secret key (sb_secret_...):
SUPABASE_SECRET_KEY=

# Mercado Pago
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Apenas para testes de assinatura (/preapproval): e-mail da conta Comprador Teste
# criada no Mercado Pago no mesmo país da conta Vendedor Teste.
MERCADO_PAGO_TEST_PAYER_EMAIL=
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=http://localhost:3000/api/integrations/mercadopago/callback

# 32 bytes em base64. Gere com: openssl rand -base64 32
FINANCIAL_ENCRYPTION_KEY=
